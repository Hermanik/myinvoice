{% extends '_layout.html.twig' %}

{% block content %}
<h1 style="margin:0 0 16px;font-size:22px;font-weight:600;color:#15131D;">
  Reminder — unpaid invoice
</h1>

<p style="margin:0 0 12px;">Hello,</p>

<p style="margin:0 0 16px;">
  this is a friendly reminder that invoice <strong>no. {{ invoice.varsymbol }}</strong>
  is <strong style="color:#C2410C;">{{ days_overdue }} day{% if days_overdue != 1 %}s{% endif %} overdue</strong>
  and has not been paid yet.
</p>

<table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;background:#FEF3E7;border:1px solid #FBC78A;border-radius:8px;margin:16px 0;">
  <tr>
    <td style="padding:16px 20px;">
      <table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;font-size:14px;color:#403B52;">
        <tr>
          <td style="padding:4px 0;color:#7A748C;width:42%;">Variable symbol</td>
          <td style="padding:4px 0;font-family:monospace;font-weight:600;color:#15131D;">{{ invoice.varsymbol }}</td>
        </tr>
        <tr>
          <td style="padding:4px 0;color:#7A748C;">Issue date</td>
          <td style="padding:4px 0;">{{ invoice.issue_date|date('M j, Y') }}</td>
        </tr>
        <tr>
          <td style="padding:4px 0;color:#7A748C;">Due date</td>
          <td style="padding:4px 0;font-weight:600;color:#C2410C;">{{ invoice.due_date|date('M j, Y') }}</td>
        </tr>
        <tr>
          <td style="padding:4px 0;color:#7A748C;">Days overdue</td>
          <td style="padding:4px 0;font-weight:600;color:#C2410C;">{{ days_overdue }}</td>
        </tr>
        <tr>
          <td style="padding:8px 0 0;color:#7A748C;border-top:1px solid #FBC78A;">Amount due</td>
          <td style="padding:8px 0 0;border-top:1px solid #FBC78A;font-size:18px;font-weight:700;color:{{ accent }};font-family:monospace;">
            {{ amount_to_pay|number_format(2, '.', ',') }} {{ invoice.currency }}
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>{% if late_interest %}

<table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;background:#F6F5FA;border:1px solid #E7E3EE;border-radius:8px;margin:16px 0;">
  <tr>
    <td style="padding:16px 20px;">
      <table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;font-size:14px;color:#403B52;">
        <tr>
          <td style="padding:4px 0;color:#7A748C;width:42%;">Late-payment interest as of {{ late_interest.as_of|date('M j, Y') }}{% if late_interest.billed_interest > 0 %} – not yet invoiced{% endif %}</td>
          <td style="padding:4px 0;font-weight:600;font-family:monospace;color:#15131D;">{{ late_interest.interest|number_format(2, '.', ',') }} {{ invoice.currency }}</td>
        </tr>
        {% if late_interest.billed_interest > 0 %}
        <tr>
          <td style="padding:4px 0;color:#7A748C;width:42%;">Already invoiced separately up to {{ late_interest.billed_through|date('M j, Y') }}</td>
          <td style="padding:4px 0;font-weight:600;font-family:monospace;color:#15131D;">{{ late_interest.billed_interest|number_format(2, '.', ',') }} {{ invoice.currency }}</td>
        </tr>
        {% endif %}
        {% if late_interest.fixed_cost.claimable %}
        <tr>
          <td style="padding:4px 0;color:#7A748C;width:42%;">Fixed compensation of the costs of claiming the receivable</td>
          <td style="padding:4px 0;font-weight:600;font-family:monospace;color:#15131D;">CZK {{ late_interest.fixed_cost.amount_czk|number_format(2, '.', ',') }}</td>
        </tr>
        {% endif %}
      </table>
      <p style="margin:8px 0 0;font-size:12px;color:#7A748C;">
        We claim late-payment interest from {{ late_interest.delay_from|date('M j, Y') }}: annual rate {{ late_interest.annual_rate_percent|number_format(2, '.', ',') }} % = CNB two-week repo rate {{ late_interest.repo.rate_percent|number_format(2, '.', ',') }} % valid on {{ late_interest.repo.half_year_start|date('M j, Y') }} + 8 percentage points (section 1970 of the Czech Civil Code, section 2 of Government Regulation No. 351/2013 Sb.).
      </p>
    </td>
  </tr>
</table>{% endif %}


{% if qr_data_uri %}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:32px 0 8px;">
  <tr>
    <td align="center">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:0 auto;">
        <tr>
          <td style="text-align:center;padding:12px;background:#fff;border:1px solid #E7E3EE;border-radius:8px;">
            <img src="{{ qr_data_uri }}" alt="QR payment" width="180" height="180" style="display:block;margin:0 auto;">
            <div style="font-size:11px;color:#7A748C;letter-spacing:1px;margin-top:6px;text-transform:uppercase;">QR payment</div>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
{% endif %}

<p style="margin:16px 0 8px;font-size:14px;color:#5A5470;">
  The invoice PDF is attached{% if qr_data_uri %}; you can pay by scanning the QR code above{% endif %}.
  If payment was sent in the past few days, please disregard this reminder.
</p>

<p style="margin:24px 0 0;font-size:13px;color:#7A748C;">
  Thank you.
</p>
{% endblock %}
