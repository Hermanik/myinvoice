{% extends '_layout.html.twig' %}

{% block content %}
<h1 style="margin:0 0 16px;font-size:22px;font-weight:600;color:#15131D;">Nová zpráva v datové schránce</h1>

<p style="margin:0 0 16px;">Dobrý den,</p>

<p style="margin:0 0 16px;">
  do datové schránky <strong>{{ box_label }}</strong> ({{ box_db_id }}) dorazila nová zpráva
  {% if is_tax_office %}<strong style="color:#B42318;">od finančního úřadu</strong>{% endif %}.
  Upozornění vzniklo z e-mailové notifikace systému datových schránek, aplikace se do schránky nepřihlásila.
</p>

<table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 0 20px;font-size:14px;line-height:1.6;">
  <tr><td style="padding:2px 16px 2px 0;color:#7A748C;">Věc</td><td><strong>{{ annotation|default('(bez věci)') }}</strong></td></tr>
  <tr><td style="padding:2px 16px 2px 0;color:#7A748C;">Odesílatel</td><td>{{ sender_name|default('—') }} ({{ sender_box_id }})</td></tr>
  <tr><td style="padding:2px 16px 2px 0;color:#7A748C;">Číslo zprávy</td><td>{{ dm_id }}</td></tr>
  <tr><td style="padding:2px 16px 2px 0;color:#7A748C;">Dorazila</td><td>{{ arrived_at }}</td></tr>
  <tr><td style="padding:2px 16px 2px 0;color:#7A748C;">Doručí se fikcí</td><td>{{ fiction_date }}</td></tr>
</table>

<p style="margin:0 0 16px;padding:12px 16px;background:{{ accent_soft }};border-radius:8px;font-size:14px;">
  <strong>Zpráva zatím není doručena.</strong> Doručená bude, až ji někdo oprávněný otevře na portálu datových schránek,
  nejpozději však {{ fiction_date }} (fikce doručení po 10 dnech). Od doručení běží případné zákonné lhůty.
</p>

<p style="margin:0 0 8px;">
  <a href="{{ portal_link }}" style="color:{{ accent }};">Otevřít portál datových schránek</a>
  {% if app_link %} &middot; <a href="{{ app_link }}" style="color:{{ accent }};">Zobrazit v aplikaci</a>{% endif %}
</p>
{% endblock %}
